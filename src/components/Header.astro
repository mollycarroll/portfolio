---
import { site, nav } from '../data/site';

const path = Astro.url.pathname;
const isCurrent = (href: string) => (href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`));
---

<header class="site-header">
	<a class="brand" href="/">
		<span class="brand-name">{site.name}</span>
		<span class="brand-tag mono">{site.tagline}</span>
	</a>
	<div class="header-right">
		<div class="theme-toggle mono" role="group" aria-label="Colour theme">
			<button type="button" data-theme-choice="light" aria-label="Light mode">☀</button>
			<button type="button" data-theme-choice="dark" aria-label="Dark mode">☾</button>
		</div>
		<nav class="main-nav" aria-label="Main">
			{
				nav.map((item) => (
					<a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
						{item.label}
					</a>
				))
			}
		</nav>
		<a class="resume" href={site.resume} download>Resume ↓</a>
	</div>
</header>

<style>
	.site-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 0 4px 12px;
	}

	.brand {
		display: flex;
		flex-direction: column;
		gap: 2px;
	}

	.brand-name {
		font-weight: 700;
		font-size: 16px;
	}

	.brand-tag {
		font-size: 12px;
		color: var(--muted);
	}

	.header-right {
		display: flex;
		align-items: center;
		gap: 18px;
	}

	.theme-toggle {
		display: flex;
		gap: 2px;
		padding: 3px;
		border: 1px solid var(--rule);
		border-radius: 99px;
		font-size: 11px;
	}

	.theme-toggle button {
		all: unset;
		cursor: pointer;
		padding: 4px 10px;
		border-radius: 99px;
		color: var(--muted);
	}

	.theme-toggle button:focus-visible {
		outline: 2px solid var(--accent-text);
	}

	.theme-toggle button[aria-pressed='true'] {
		background: var(--toggle-on-bg);
		color: var(--toggle-on-fg);
	}

	.main-nav {
		display: flex;
		gap: 2px;
		font: 500 14px 'Space Grotesk', sans-serif;
	}

	.main-nav a {
		display: flex;
		align-items: center;
		gap: 7px;
		padding: 7px 13px;
		border-radius: 99px;
		color: var(--nav-muted);
	}

	.main-nav a:hover {
		color: var(--text);
	}

	/* Current page: filled pill with an accent dot */
	.main-nav a[aria-current='page'] {
		background: var(--tile);
		color: var(--text);
	}

	.main-nav a[aria-current='page']::before {
		content: '';
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: var(--accent);
	}

	.resume {
		display: flex;
		align-items: center;
		gap: 6px;
		padding: 7px 14px;
		border-radius: 99px;
		background: var(--accent);
		color: var(--accent-fg);
		font: 700 13px 'Space Grotesk', sans-serif;
	}

	.resume:hover {
		background: var(--alt);
		color: var(--alt-fg);
	}

	/* Narrow screens: name + controls on the first row, nav below */
	@media (max-width: 860px) {
		.site-header {
			flex-wrap: wrap;
			row-gap: 12px;
		}

		.header-right {
			display: contents;
		}

		.brand {
			margin-right: auto;
		}

		.theme-toggle {
			order: 1;
			margin-right: 10px;
		}

		.resume {
			order: 2;
		}

		.main-nav {
			order: 3;
			width: 100%;
			flex-wrap: wrap;
			margin-left: -13px;
			font-size: 13px;
		}

		.main-nav a {
			padding: 7px 10px;
		}
	}
</style>

<script>
	const buttons = document.querySelectorAll<HTMLButtonElement>('[data-theme-choice]');

	function apply(theme: string) {
		document.documentElement.dataset.theme = theme;
		buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.themeChoice === theme)));
	}

	apply(document.documentElement.dataset.theme ?? 'light');

	buttons.forEach((b) =>
		b.addEventListener('click', () => {
			const theme = b.dataset.themeChoice ?? 'light';
			apply(theme);
			try {
				localStorage.setItem('theme', theme);
			} catch {}
		}),
	);
</script>
